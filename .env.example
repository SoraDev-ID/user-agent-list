# ==============================================================================
# Environment Configuration for user-agent-list
# ==============================================================================
# Salin file ini menjadi '.env' jika Anda ingin menggunakan API berbayar/terautentikasi.
# Script tetap berjalan 100% normal tanpa API key menggunakan public data feeds bawaan.

# Optional: WhatIsMyBrowser API Key (jika Anda memiliki akun di whatismybrowser.com)
WHATISMYBROWSER_API_KEY=

# Optional: Request Timeout dalam detik (default: 15)
REQUEST_TIMEOUT=15

# Optional: User-Agent yang digunakan script saat melakukan request
FETCHER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36
